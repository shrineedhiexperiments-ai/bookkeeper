# --- Claude (bill extraction) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Storage ---
DATABASE_URL=sqlite:///./data/bookkeeper.db
UPLOAD_DIR=./data/uploads
APP_BASE_URL=http://localhost:8000
# Used to sign approve/reject links sent by email
SECRET_KEY=change-me

# --- Approval workflow ---
# Ordered tiers; the first tier whose max_amount >= bill total applies.
# Approvers sign off in sequence. An empty approver list = auto-approve.
APPROVAL_RULES=[{"max_amount": 500, "approvers": []}, {"max_amount": 5000, "approvers": ["manager@example.com"]}, {"max_amount": null, "approvers": ["manager@example.com", "cfo@example.com"]}]

# --- Email inbox (bills@yourcompany.com) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=bills@example.com
IMAP_PASSWORD=app-password
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

# --- Outbound email to approvers (optional; logged to console if unset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bills@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=bills@example.com

# --- ERP ---
ERP=zoho_books

# Zoho Books (Self Client OAuth: https://api-console.zoho.com)
# Scope: ZohoBooks.bills.CREATE,ZohoBooks.bills.READ,ZohoBooks.contacts.CREATE,ZohoBooks.contacts.READ,ZohoBooks.accountants.READ,ZohoBooks.settings.READ
ZOHO_DC=com            # com | eu | in | com.au | jp | ca | sa
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_DEFAULT_EXPENSE_ACCOUNT=  # account name used when no match, e.g. "Other Expenses"
